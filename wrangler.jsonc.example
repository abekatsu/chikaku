// このファイルの雛形。**wrangler.jsonc 本体は追跡していない。**
//
//   cp wrangler.jsonc.example wrangler.jsonc
//
// REPLACE_WITH_ で始まる3箇所を、自分の Cloudflare の値に差し替えること。
// 手順は docs/getting-started.md を参照。
//
// 秘密ではないが、リポジトリを汎用的に使えるようにするため外に出している。
// android-app/local.properties や ios-app/Config/Chikaku.xcconfig と同じ扱い。
{
  // 1つの Worker が API と ダッシュボードの静的ファイルを
  // 同じオリジンで配る (ADR-2)。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chikaku",
  "main": "server/build/worker/shim.mjs",
  "compatibility_date": "2026-08-20",

  // workers-rs は wasm にビルドしてから shim を生成する。
  "build": {
    "command": "worker-build --release server"
  },

  "assets": {
    // client のビルド出力。**Worker をデプロイする前に client をビルドすること。**
    "directory": "./client/dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // API のパスだけ Worker を先に通す。それ以外は静的ファイルが応答する。
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chikaku",
      // wrangler d1 create chikaku で採番された値。作り直したら書き換える。
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "server/migrations"
    }
  ],

  // 招待コード発行と端末登録の総当たり対策。
  // WAF の Rate Limiting Rules はゾーン配下の機能で、独自ドメインを
  // 持たない本システム (workers.dev) では使えないため Worker 内蔵の
  // バインディングを使う。period は 10 か 60 秒のみ。
  //
  // 端末登録は「親が手で入力する」操作なので毎分5回で足りる。
  // 招待コードの発行も同様に、人の操作としては毎分10回で十分。
  // 位置送信 (/api/v1/location) は刻まない。長期圏外から復帰した端末が
  // 溜めたキューを一気に掃き出すため、正常な動作を絞ってしまう。
  // あちらは 32 バイトの device_token で守られており総当たりは成立しない。
  "ratelimits": [
    { "name": "RL_REGISTER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_INVITE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],

  // 保持期間の掃除。常駐プロセスが無いので Cron で回す (ADR-4)。
  "triggers": {
    "crons": ["0 */6 * * *"]
  },

  "vars": {
    // Cloudflare Access のチームドメインと、Access アプリケーションの AUD タグ。
    // 秘密ではないが、これが誤っていると認証が通らない。
    "CHIKAKU_TEAM_DOMAIN": "https://REPLACE_WITH_TEAM.cloudflareaccess.com",
    "CHIKAKU_POLICY_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "CHIKAKU_RETENTION_DAYS": "90",
    "CHIKAKU_INVITE_TTL_MINUTES": "1440"
  },

  "observability": { "enabled": true }
}
