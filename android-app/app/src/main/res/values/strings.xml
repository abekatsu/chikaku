    <!-- 説明画面（プロミネントディスクロージャー） -->
    <string name="disclosure_title">このアプリについて</string>
    <string name="disclosure_body">このアプリは、あなたの現在地をご家族（お子さん）に知らせるためのものです。\n\nアプリを閉じている間や画面が消えている間も、バックグラウンドで位置情報を取得します。取得した位置は、ご家族だけが見られる専用のサーバーに送られます。\n\n電池を節約するため、位置が大きく動いたときだけ送信します。じっとしている間はほとんど通信しません。</string>
    <string name="disclosure_point_who">見られるのは、登録されたご家族だけです</string>
    <string name="disclosure_point_when">アプリを閉じている間も位置を取得します</string>
    <string name="disclosure_point_stop">いつでもこのアプリから停止できます</string>
    <string name="disclosure_agree">同意して次へ</string>
    <string name="disclosure_decline">同意しない</string>
    <string name="disclosure_declined_message">同意がないと見守りを開始できません。内容を確認して、よろしければ「同意して次へ」を押してください。</string>

    <!-- ペアリング -->
    <string name="pairing_title">家族とつなぐ</string>
    <string name="pairing_body">お子さんから伝えられた「招待コード」を入力してください。</string>
    <string name="pairing_code_label">招待コード</string>
    <string name="pairing_name_label">この端末の名前（例: お父さんのスマホ）</string>
    <string name="pairing_submit">つなぐ</string>
    <string name="pairing_in_progress">接続しています…</string>
    <string name="pairing_error_empty_code">招待コードを入力してください。</string>
    <string name="pairing_error_failed">つなげませんでした: %1$s</string>
    <string name="pairing_error_network">インターネットにつながっていないようです。電波の良い場所でもう一度お試しください。</string>
    <string name="pairing_error_server">サーバーが応答しませんでした（%1$d）。しばらくしてからお試しください。</string>
    <string name="pairing_error_invalid_code">招待コードが正しくないか、期限が切れています。</string>
    <string name="pairing_advanced">詳細設定（サーバーURL）</string>
