{
  // e2e テスト専用の設定。本番の wrangler.jsonc とは別に持つ理由:
  //  - 静的アセット (client/dist) を要求しない。API だけを対象にする
  //  - Access のチームドメインをテストが立てるローカル JWKS サーバーに向ける
  //    → 検証経路を迂回せず、本物と同じ RS256 検証を通す
  "name": "chikaku-test",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-08-20",
  "build": { "command": "worker-build --release server" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chikaku-test",
      "database_id": "local-test-only",
      "migrations_dir": "migrations"
    }
  ],
  // 本番と同じ経路を通す。バインディングを省くと ratelimit::check が
  // 500 で落ちるため、宣言は必須。
  //
  // RL_REGISTER は送信元 IP で刻まれ、ローカルでは全テストが同じ IP に
  // なるので、他のテストを巻き込まないよう上限を上げてある。
  // RL_INVITE は子アカウント単位で刻まれ seedFamily がテストごとに
  // 別アカウントを作るため、本番に近い小さな値のまま 429 を実際に確認できる。
  "ratelimits": [
    { "name": "RL_REGISTER", "namespace_id": "1001", "simple": { "limit": 1000, "period": 60 } },
    { "name": "RL_INVITE", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],

  "vars": {
    "CHIKAKU_TEAM_DOMAIN": "http://127.0.0.1:8799",
    "CHIKAKU_POLICY_AUD": "test-aud-tag",
    "CHIKAKU_RETENTION_DAYS": "90",
    "CHIKAKU_INVITE_TTL_MINUTES": "1440"
  }
}
