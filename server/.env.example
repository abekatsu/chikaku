# コピーして .env として使う。本番では環境変数を直接与える。

# SQLite の置き場所。ディレクトリは事前に作っておく。
CHIKAKU_DATABASE_URL=sqlite://chikaku.db?mode=rwc

# 待ち受けアドレス。TLS は前段のリバースプロキシで終端する前提のため、
# 既定は 127.0.0.1。ここを 0.0.0.0 にすると平文で外部に晒される。
CHIKAKU_BIND=127.0.0.1:8080

# 位置履歴の保持期間（日）。CLAUDE.md §5 の「無期限保存を避ける」に対応。
CHIKAKU_RETENTION_DAYS=90

# ダッシュボードのログインセッションの有効期間（時間）
CHIKAKU_SESSION_TTL_HOURS=720

# 招待コードの有効期間（分）
CHIKAKU_INVITE_TTL_MINUTES=1440

# ダッシュボードのオリジン。カンマ区切り。空なら CORS を一切許可しない。
CHIKAKU_CORS_ORIGINS=https://dashboard.example.com

# ログレベル (tracing の EnvFilter 形式)
CHIKAKU_LOG=info,tower_http=debug
