{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/check-private.py\" --hook",
            "statusMessage": "公開できない値が混ざっていないか確認中",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
