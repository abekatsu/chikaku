{
  "name": "chikaku",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix client run build",
    "deploy": "npm run build && wrangler deploy",
    "test:server": "node server/tests/e2e.mjs",
    "typecheck": "npm --prefix client run typecheck",
    "db:migrate": "wrangler d1 migrations apply chikaku --remote",
    "test:ios": "node ios-app/Tools/contract-check/run.mjs"
  },
  "devDependencies": {
    "jose": "^6.1.0",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "workerd@1.20260820.1": true
  }
}
